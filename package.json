{
  "name": "cypress-sdet-starter",
  "version": "1.0.0",
  "description": "Starter kit de automação E2E com Cypress + TypeScript e demo app local em Express.",
  "private": true,
  "scripts": {
    "demo:start": "node apps/demo/server.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "test": "npm run lint && npm run ci",
    "ci": "start-server-and-test demo:start http://localhost:3000 cy:run",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cypress": "^13.13.2",
    "cypress-mochawesome-reporter": "^3.8.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "mochawesome": "^7.1.3",
    "prettier": "^3.3.3",
    "start-server-and-test": "^2.0.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "lint-staged": {
    "**/*.{js,ts,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ],
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
