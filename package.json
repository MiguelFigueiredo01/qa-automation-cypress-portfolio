{
  "name": "qa-automation-cypress-portfolio",
  "version": "1.0.0",
  "description": "Portfólio profissional de automação E2E com Cypress e app demo local",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "demo:start": "node apps/demo/server.js",
